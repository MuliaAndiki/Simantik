# ==============================================================================
# SIMANTIK - Root Environment Configuration for VPS Deployment
# ==============================================================================

# Port exposed to public traffic (Nginx load balancer)
NGINX_PORT=80

# Public domain (e.g. https://simantik.id)
NEXT_PUBLIC_APP_URL=https://simantik.id
# Server-only backend & Cloudflare R2 base URLs (no NEXT_PUBLIC_ prefix)
BACKEND_URL=https://simantik.id
R2_URL=https://cdn.simantik.id

# OpenTelemetry Settings (traces sent to jaeger:4317 inside Docker network)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=simantik-backend
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_INSECURE=true

# Database credentials (if using local docker postgres)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simantik_db
