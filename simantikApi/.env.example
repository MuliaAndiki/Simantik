# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# Shared secret required in the "X-API-SECRET" header for every request.
API_SECRET=change-me-api-secret

# Secret used to sign/verify JWT access tokens, and their lifetime in hours.
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY_HOURS=24

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# ---------------------------------------------------------------------------
# Preferred: a single connection string as provided by Neon. Always keep
# sslmode=require (Neon rejects unencrypted connections).
# Example Neon pooled connection string:
DATABASE_URL=postgres://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# Fallback: discrete parts, used only when DATABASE_URL is empty (e.g. local
# Postgres via docker-compose).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=boilerpad
DB_SSLMODE=disable

# Connection pool tuning. Neon's pooler (pgbouncer, transaction mode) works
# best with a modest number of open connections and short idle lifetimes.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5

# Run db.AutoMigrate on boot. Intended for local development only — disable
# in production and use golang-migrate (see /migrations) instead.
DB_AUTO_MIGRATE=true
