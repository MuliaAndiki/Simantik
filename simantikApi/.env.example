# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# Shared secret required in the "X-API-SECRET" header for every request.
API_SECRET=change-me-api-secret

# ---------------------------------------------------------------------------
# JWT & Session Security
# ---------------------------------------------------------------------------
# Secret used to sign/verify short-lived JWT access tokens.
JWT_SECRET=change-me-jwt-secret
# Access token lifetime in minutes (default: 15 minutes as per PRD security specs)
JWT_ACCESS_EXPIRY_MINUTES=15
# Refresh token lifetime in days (default: 7 days)
REFRESH_EXPIRY_DAYS=7

# Cookie settings for httpOnly refresh token storage
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# Google OAuth / OIDC
# ---------------------------------------------------------------------------
# Google OAuth Client credentials (configured via Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback/google

# ---------------------------------------------------------------------------
# Resend Email Service (Registration OTP / Password Recovery OTP)
# If RESEND_API_KEY is left empty, the service falls back to a development logger.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=SIMANTIK <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# ---------------------------------------------------------------------------
# Preferred: a single connection string as provided by Neon. Always keep
# sslmode=require (Neon rejects unencrypted connections).
# Example Neon pooled connection string:
DATABASE_URL=postgres://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# Fallback: discrete parts, used only when DATABASE_URL is empty (e.g. local
# Postgres via docker-compose).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simantik_db
DB_SSLMODE=disable

# Connection pool tuning. Neon's pooler (pgbouncer, transaction mode) works
# best with a modest number of open connections and short idle lifetimes.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5

# Run db.AutoMigrate on boot. Intended for local development only — disable
# in production and use golang-migrate (see /migrations) instead.
# If tables already exist, AutoMigrate is skipped automatically for fast startup.
# Set DB_AUTO_MIGRATE_FORCE=true to force re-running schema synchronization.
DB_AUTO_MIGRATE=true
DB_AUTO_MIGRATE_FORCE=false

# Database logging: warn (default, quiet & fast), info (verbose SQL queries), silent
DB_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# OpenTelemetry Tracing
# ---------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=simantik-backend
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_INSECURE=true

