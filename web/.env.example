# ==============================================================================
# SIMANTIK - Web Frontend Environment Configuration
# ==============================================================================

NODE_ENV=development
AUTH_SECRET_KEY=simantik-super-secret-auth-key-change-in-production
NEXT_INTERNAL_API_SECRET=your-internal-api-secret-matching-backend

# Cloudflare R2 Object Storage (Private Credentials)
NEXT_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
NEXT_ACCESS_KEY_ID=your-r2-access-key-id
NEXT_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Public App URLs & Endpoints
NEXT_PUBLIC_APP_URL=https://simantik.id
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BASEPATH=/home
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_INTERNAL_API_SECRET=your-internal-api-secret-matching-backend

# Search Console Verification (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Cloudflare R2 Public CDN / Custom Domain
NEXT_PUBLIC_R2_URL=https://simantik.id

# CI & Build
SKIP_ENV_VALIDATION=false
